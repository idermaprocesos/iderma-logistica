<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaFichas.Pages.MantenimientoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IdermaFichas.Pages">

    <Page.Resources>
        <Style x:Key="BotonCompacto" TargetType="Button">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="2">
            <TextBlock Style="{StaticResource TituloPaginaStyle}" Text="Mantenimiento" />
            <TextBlock
                Style="{StaticResource SubtituloPaginaStyle}"
                Text="Cada equipo tiene su propio plazo. Logística lleva el control; el reporte detallado se abre en la app de Mantenimiento."
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="ComboFiltro"
                HorizontalAlignment="Stretch"
                Header="Ver"
                SelectedIndex="0"
                SelectionChanged="Filtro_Changed">
                <ComboBoxItem Content="Todos" />
                <ComboBoxItem Content="Preventivo" />
                <ComboBoxItem Content="Correctivo" />
                <ComboBoxItem Content="Crítico" />
                <ComboBoxItem Content="Vencidos y por vencer" />
            </ComboBox>
            <TextBlock
                x:Name="TextoResumen"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Opacity="0.75"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Click="Agregar_Click"
                Content="Agregar equipo"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <InfoBar x:Name="Aviso" Grid.Row="2" IsClosable="True" IsOpen="False" />

        <ListView x:Name="Lista" Grid.Row="3" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="8,1" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FilaControlEquipo">
                    <Grid Padding="0,4" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="168" />
                            <ColumnDefinition Width="168" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="0">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{x:Bind Titulo}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Opacity="0.7"
                                Text="{x:Bind Lugar}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{x:Bind Plazo}"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{x:Bind Estado}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Opacity="0.7"
                                Text="{x:Bind Fechas}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                            <Button
                                Click="Registrar_Click"
                                Content="Control"
                                Style="{StaticResource BotonCompacto}"
                                Tag="{x:Bind Id}"
                                ToolTipService.ToolTip="Registrar el control de hoy" />
                            <Button
                                Click="Editar_Click"
                                Content="Editar"
                                Style="{StaticResource BotonCompacto}"
                                Tag="{x:Bind Id}"
                                ToolTipService.ToolTip="Cambiar el plazo y los datos de este equipo" />
                            <Button
                                Click="Exhaustivo_Click"
                                Content="Exhaustivo"
                                Style="{StaticResource BotonCompacto}"
                                Tag="{x:Bind Codigo}"
                                ToolTipService.ToolTip="Abrir el detalle en la app de Mantenimiento" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

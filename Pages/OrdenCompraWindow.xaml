<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaFichas.Pages.OrdenCompraWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:IdermaFichas.Models">

    <Grid Padding="20,16,20,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button VerticalAlignment="Center" Click="Volver_Click" Content="Volver" />
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Orden de compra mensual" />
                <TextBlock
                    Opacity="0.72"
                    Text="FO0LOG015 · Iderma Capilar. Elija el tipo de precio de cada producto y exporte en PDF o Excel."
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock
                x:Name="ResumenProductos"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="0 productos" />
        </Grid>

        <InfoBar
            x:Name="BarraAviso"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False" />

        <Grid Grid.Row="2" ColumnSpacing="10" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="CajaMes" Header="Mes / Año" />
            <DatePicker
                x:Name="FechaElaboracion"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Header="Fecha de elaboración" />
            <TextBox
                x:Name="CajaCobertura"
                Grid.Column="2"
                Header="Período de cobertura" />
            <ComboBox
                x:Name="ComboEstado"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                Header="Estado" />
            <TextBox
                x:Name="CajaElaborado"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Header="Elaborado por"
                PlaceholderText="Nombre de quien elabora" />
            <TextBox
                x:Name="CajaRevisado"
                Grid.Row="1"
                Grid.Column="2"
                Grid.ColumnSpan="2"
                Header="Revisado por"
                PlaceholderText="Nombre de quien revisa" />
            <TextBlock
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Opacity="0.72"
                Text="Sin IGV, IGV y Con IGV usan el último precio, en soles o dólares. Si la cantidad es 0 se muestra el precio unitario. El total de abajo suma la columna Con IGV."
                TextWrapping="Wrap" />
        </Grid>

        <AutoSuggestBox
            x:Name="BuscarInventario"
            Grid.Row="3"
            Margin="0,0,0,8"
            PlaceholderText="Agregar producto del inventario: código o nombre"
            QueryIcon="Find"
            SuggestionChosen="BuscarInventario_SuggestionChosen"
            TextChanged="BuscarInventario_TextChanged" />

        <ScrollViewer
            Grid.Row="4"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
        <ListView
            x:Name="Lista"
            MinWidth="1400"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="44" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.Header>
                <Grid Height="32" Padding="8,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="122" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="136" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Text="Código" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Text="Insumo" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Text="Marca" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Text="Proveedor" />
                    <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Text="RUC" />
                    <TextBlock Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Text="Cons." />
                    <TextBlock Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Text="Stock" />
                    <TextBlock Grid.Column="7" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Text="Pedir" />
                    <TextBlock Grid.Column="8" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Text="Und." />
                    <TextBlock Grid.Column="9" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Text="Sin IGV" />
                    <TextBlock Grid.Column="10" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Text="IGV 18%" />
                    <TextBlock Grid.Column="11" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Text="Con IGV" />
                    <TextBlock Grid.Column="12" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Opacity="0.7" Text="Tipo de precio" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:LineaOrdenCompra">
                    <Border
                        Height="44"
                        Padding="8,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid VerticalAlignment="Center" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" MinWidth="140" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="122" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="136" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Codigo}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind Nombre}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="{x:Bind TextoMarca}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Text="{x:Bind TextoProveedor}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Text="{x:Bind TextoRuc}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="5"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Text="{x:Bind TextoConsumo}"
                                TextAlignment="Right" />
                            <TextBlock
                                Grid.Column="6"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Text="{x:Bind TextoStock}"
                                TextAlignment="Right" />
                            <NumberBox
                                Grid.Column="7"
                                Height="32"
                                VerticalAlignment="Center"
                                LargeChange="10"
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind CantidadPedir, Mode=TwoWay}" />
                            <TextBlock Grid.Column="8" VerticalAlignment="Center" Text="{x:Bind TextoUnidad}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="9"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Text="{x:Bind TextoSinIgv, Mode=OneWay}"
                                TextAlignment="Right"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="10"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Text="{x:Bind TextoIgv, Mode=OneWay}"
                                TextAlignment="Right"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="11"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                FontWeight="SemiBold"
                                Text="{x:Bind TextoTotal, Mode=OneWay}"
                                TextAlignment="Right"
                                TextTrimming="CharacterEllipsis" />
                            <ComboBox
                                Grid.Column="12"
                                Height="32"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind Tipos}"
                                SelectedItem="{x:Bind TipoPrecio, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        </ScrollViewer>

        <Grid Grid.Row="5" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TotalGeneral"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Total con IGV: —"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="1"
                MinWidth="140"
                Click="Guardar_Click"
                Content="Guardar" />
            <Button
                Grid.Column="2"
                MinWidth="140"
                Click="ExportarPdf_Click"
                Content="Exportar PDF"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                Grid.Column="3"
                MinWidth="140"
                Click="ExportarExcel_Click"
                Content="Exportar Excel" />
        </Grid>
    </Grid>
</Page>

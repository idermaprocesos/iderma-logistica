<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaFichas.Pages.RegistroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:IdermaFichas.Pages"
    mc:Ignorable="d">

    <Grid Padding="24,8,24,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Name="TituloPagina" Style="{StaticResource TituloPaginaStyle}" Text="Registro" />
            <TextBlock
                x:Name="SubtituloUnidad"
                Style="{StaticResource SubtituloPaginaStyle}"
                Text="Ingresos por producto, agrupados por unidad." />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel x:Name="PanelUnidades" Orientation="Horizontal" Spacing="8" />
                <ToggleButton
                    x:Name="ChipStockCritico"
                    Click="ChipStock_Click">
                    <TextBlock x:Name="TextoChipStock" Text="Stock crítico" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ChipVencidos"
                    Click="ChipCaducidad_Click"
                    Tag="1">
                    <TextBlock x:Name="TextoChipVencidos" Text="Vencidos" />
                </ToggleButton>
                <ToggleButton
                    x:Name="ChipProximos"
                    Click="ChipCaducidad_Click"
                    Tag="2">
                    <TextBlock x:Name="TextoChipProximos" Text="Próximos 30 días" />
                </ToggleButton>
                <Button Click="LimpiarFiltros_Click" Content="Limpiar filtros" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="8">
            <Grid VerticalAlignment="Center" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="CajaBusqueda"
                    MinHeight="32"
                    MaxHeight="32"
                    VerticalAlignment="Center"
                    AcceptsReturn="False"
                    PlaceholderText="Buscar por código, nombre, categoría, proveedor, ubicación o lote"
                    TextWrapping="NoWrap"
                    TextChanged="CajaBusqueda_TextChanged" />
                <ComboBox
                    x:Name="ComboOrden"
                    Grid.Column="1"
                    MinHeight="32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Ordenar"
                    SelectionChanged="Filtros_Changed" />
                <ComboBox
                    x:Name="ComboAnio"
                    Grid.Column="2"
                    MinHeight="32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Año del historial"
                    SelectionChanged="Periodo_Changed" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Opacity="0.75"
                    Text="Meses:" />
                <ScrollViewer
                    Grid.Column="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel x:Name="PanelMeses" Orientation="Horizontal" Spacing="4" />
                        <Button
                            VerticalAlignment="Center"
                            Click="TodosMeses_Click"
                            Content="Todos los meses" />
                        <ToggleButton
                            x:Name="ChipUltimos3"
                            VerticalAlignment="Center"
                            Click="AtajoMeses_Click"
                            Tag="3"
                            Content="Últimos 3 meses" />
                        <ToggleButton
                            x:Name="ChipUltimos6"
                            VerticalAlignment="Center"
                            Click="AtajoMeses_Click"
                            Tag="6"
                            Content="Últimos 6 meses" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="ComboStock"
                MinHeight="32"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                PlaceholderText="Stock"
                SelectionChanged="Filtros_Changed" />
            <ComboBox
                x:Name="ComboCaducidad"
                Grid.Column="1"
                MinHeight="32"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                PlaceholderText="Caducidad"
                SelectionChanged="Filtros_Changed" />
            <ComboBox
                x:Name="ComboCategoria"
                Grid.Column="2"
                MinHeight="32"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                PlaceholderText="Categoría"
                SelectionChanged="Filtros_Changed" />
            <ComboBox
                x:Name="ComboProveedor"
                Grid.Column="3"
                MinHeight="32"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                PlaceholderText="Proveedor"
                SelectionChanged="Filtros_Changed" />
            <ComboBox
                x:Name="ComboUbicacion"
                Grid.Column="4"
                MinHeight="32"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                PlaceholderText="Ubicación"
                SelectionChanged="Filtros_Changed" />
            <ComboBox
                x:Name="ComboLote"
                Grid.Column="5"
                MinHeight="32"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                PlaceholderText="Lote"
                SelectionChanged="Filtros_Changed" />
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="TituloLista"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Productos"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="ComboAlcanceSeleccion"
                        Grid.Column="1"
                        MinWidth="148"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Qué movimientos incluir en el reporte de los productos marcados." />
                    <Button
                        Grid.Column="2"
                        Click="ExportarSeleccionadas_Click"
                        Content="Exportar seleccionadas (PDF/Excel)"
                        ToolTipService.ToolTip="Exporta el historial del periodo (año o meses) de los productos marcados." />
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton
                        x:Name="BotonModoSeleccionar"
                        Click="ModoSeleccionar_Click"
                        ToolTipService.ToolTip="Con el modo activo, el clic marca productos y no abre el historial. Ctrl añade o quita uno. Mayús marca un rango.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8B3;" />
                            <TextBlock x:Name="TextoModoSeleccionar" Text="Seleccionar" />
                        </StackPanel>
                    </ToggleButton>
                    <DropDownButton
                        Grid.Column="1"
                        ToolTipService.ToolTip="Marca o desmarca la lista visible: todas, ninguna, cruzada o armonía.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                            <TextBlock Text="Marcar lista" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="SeleccionarTodas_Click" Text="Seleccionar todas" />
                                <MenuFlyoutItem Click="DeseleccionarTodas_Click" Text="Deseleccionar todas" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="SeleccionarCruzada_Click" Text="Selección cruzada (una sí, una no)" />
                                <MenuFlyoutItem Click="SeleccionarArmonia_Click" Text="Selección armonía (dos sí, una no)" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <TextBlock
                        x:Name="ResumenMarcas"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Opacity="0.7"
                        TextWrapping="Wrap" />
                </Grid>
                <ListView
                    x:Name="ListaProductos"
                    Grid.Row="2"
                    IsItemClickEnabled="True"
                    ItemClick="ListaProductos_ItemClick"
                    KeyDown="ListaProductos_KeyDown"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ProductoRegistroItem">
                            <Grid Padding="4,10" ColumnSpacing="12">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Click="VerEnCatalogo_Click"
                                            Tag="{x:Bind Id}"
                                            Text="Ver en el Inventario" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="132" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    MinWidth="32"
                                    MinHeight="32"
                                    Padding="4"
                                    VerticalAlignment="Center"
                                    Click="MarcaFicha_Click"
                                    Tapped="MarcaFicha_Tapped"
                                    IsChecked="{x:Bind EstaMarcada, Mode=TwoWay}"
                                    Tag="{x:Bind Id}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Codigo}" />
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Nombre}" />
                                    <TextBlock Opacity="0.65" Text="{x:Bind Resumen}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="0" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="#3DD68C"
                                            Text="{x:Bind TotalIngresos}" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="#E85C5C"
                                            Text="{x:Bind TotalSalidas}" />
                                    </StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Opacity="0.65"
                                        Text="{x:Bind UltimoIngreso}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Historial de ingresos" />
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton
                            x:Name="BotonModoEditarMovimientos"
                            MinWidth="120"
                            Padding="12,6"
                            Click="ModoEditarMovimientos_Click"
                            Content="Seleccionar"
                            ToolTipService.ToolTip="Marque movimientos del historial para editar uno o borrar varios." />
                        <Button
                            x:Name="BotonEditarMovimiento"
                            Grid.Column="1"
                            Click="EditarMovimiento_Click"
                            Content="Editar"
                            IsEnabled="False" />
                        <Button
                            x:Name="BotonBorrarMovimientos"
                            Grid.Column="2"
                            Click="BorrarMovimientos_Click"
                            Content="Borrar"
                            IsEnabled="False" />
                        <Button
                            x:Name="BotonBorrarLotes"
                            Grid.Column="3"
                            Click="BorrarLotes_Click"
                            Content="Borrar lotes"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Quita lotes de este producto y descuenta su cantidad de la existencia." />
                        <ComboBox
                            x:Name="ComboAlcanceHistorial"
                            Grid.Column="4"
                            MinWidth="148"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Qué movimientos incluir en el reporte de este producto." />
                        <Button
                            Grid.Column="5"
                            Click="ExportarHistorial_Click"
                            Content="Exportar historial (PDF/Excel)"
                            ToolTipService.ToolTip="Exporta el historial visible de este producto (año o meses filtrados)." />
                    </Grid>
                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="TituloProducto"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Elija un producto"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Spacing="2">
                            <TextBlock
                                x:Name="ResumenProducto"
                                HorizontalAlignment="Right"
                                Opacity="0.7"
                                Text="La lista de la izquierda muestra todos los productos de la unidad."
                                TextWrapping="Wrap" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="TotalesProducto" Opacity="0.85" Text="" />
                                <TextBlock x:Name="TextoIngresosProducto" FontWeight="SemiBold" Foreground="#3DD68C" Text="" />
                                <TextBlock x:Name="TextoSalidasProducto" FontWeight="SemiBold" Foreground="#E85C5C" Text="" />
                            </StackPanel>
                            <TextBlock
                                x:Name="TextoPeriodo"
                                HorizontalAlignment="Right"
                                Opacity="0.7"
                                Text="" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <InfoBar
                    x:Name="BarraAviso"
                    Grid.Row="1"
                    IsClosable="True"
                    IsOpen="False" />

                <ListView
                    x:Name="ListaHistorial"
                    Grid.Row="2"
                    MinHeight="280"
                    VerticalAlignment="Stretch"
                    IsItemClickEnabled="True"
                    ItemClick="ListaHistorial_ItemClick"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:MovimientoRegistroItem">
                            <Grid Padding="8,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    MinWidth="32"
                                    MinHeight="28"
                                    Padding="4"
                                    VerticalAlignment="Center"
                                    Click="MarcaMovimiento_Click"
                                    Tapped="MarcaMovimiento_Tapped"
                                    IsChecked="{x:Bind EstaMarcada, Mode=TwoWay}"
                                    Tag="{x:Bind Id}"
                                    Visibility="{x:Bind VisibilidadMarca, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind FechaTexto}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Opacity="0.8"
                                    Text="{x:Bind DetalleTexto}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#3DD68C"
                                    Text="{x:Bind CantidadTexto}"
                                    Visibility="{x:Bind VisibilidadIngreso, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#E85C5C"
                                    Text="{x:Bind CantidadTexto}"
                                    Visibility="{x:Bind VisibilidadSalida, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind CantidadTexto}"
                                    Visibility="{x:Bind VisibilidadNeutro, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Opacity="0.6"
                                    Text="{x:Bind ResultadoTexto}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border
                    x:Name="PanelIngreso"
                    Grid.Row="3"
                    Padding="8,6"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <Border.Background>
                        <SolidColorBrush Color="{ThemeResource CardBackgroundFillColorDefault}" />
                    </Border.Background>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="TituloFormularioMovimiento" FontWeight="SemiBold" Text="Registrar un ingreso" />
                        <Grid ColumnSpacing="6" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ComboBox
                                x:Name="ComboTipoMovimiento"
                                MinHeight="32"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Tipo"
                                SelectionChanged="ComboTipoMovimiento_SelectionChanged" />
                            <NumberBox
                                x:Name="CajaCantidad"
                                Grid.Column="1"
                                MinHeight="32"
                                PlaceholderText="Cantidad"
                                Minimum="0.01"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="1" />
                            <ComboBox
                                x:Name="ComboTipoDocumento"
                                Grid.Column="2"
                                MinHeight="32"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Boleta o factura" />
                            <TextBox
                                x:Name="CajaNumeroDocumento"
                                Grid.Column="3"
                                MinHeight="32"
                                PlaceholderText="N.º documento" />
                            <ComboBox
                                x:Name="ComboPartidaMovimiento"
                                Grid.Row="1"
                                MinHeight="32"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Lote (caducidad más próxima)"
                                SelectionChanged="ComboPartidaMovimiento_SelectionChanged" />
                            <TextBox
                                x:Name="CajaLoteMovimiento"
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                MinHeight="32"
                                PlaceholderText="Lote / partida" />
                            <CalendarDatePicker
                                x:Name="FechaCaducidadMovimiento"
                                Grid.Row="1"
                                Grid.Column="3"
                                MinHeight="32"
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Caducidad" />
                            <TextBox
                                x:Name="CajaNota"
                                Grid.Row="2"
                                Grid.ColumnSpan="4"
                                MinHeight="32"
                                PlaceholderText="Nota (proveedor u observación)" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                VerticalAlignment="Center"
                                Click="AdjuntarRecibo_Click"
                                Content="Adjuntar recibo" />
                            <Button
                                x:Name="BotonQuitarRecibo"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="QuitarRecibo_Click"
                                Content="Quitar recibo"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="TextoRecibo"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Opacity="0.7"
                                Text="Sin recibo adjunto a este movimiento."
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel
                                Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <Button
                                    x:Name="BotonCancelarEdicion"
                                    Click="CancelarEdicion_Click"
                                    Content="Cancelar"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="BotonRegistrarMovimiento"
                                    Click="RegistrarIngreso_Click"
                                    Content="Registrar ingreso"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>

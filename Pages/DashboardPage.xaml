<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaFichas.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Padding="24,16,24,12" Spacing="4">
            <TextBlock x:Name="Titulo" Style="{StaticResource TituloPaginaStyle}" />
            <TextBlock
                Style="{StaticResource SubtituloPaginaStyle}"
                Text="Se muestra dentro de la aplicación. Si Google pide acceso, inicie sesión aquí." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Border
                CornerRadius="8"
                BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{ThemeResource CardBackgroundFillColorDefault}" />
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="{ThemeResource CardStrokeColorDefault}" />
                </Border.BorderBrush>
                <WebView2 x:Name="Visor" NavigationCompleted="Visor_NavigationCompleted" />
            </Border>
            <ProgressBar
                x:Name="Carga"
                VerticalAlignment="Top"
                IsIndeterminate="True" />
        </Grid>
    </Grid>
</Page>

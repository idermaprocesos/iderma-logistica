<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaFichas.Pages.AcercaDePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            MaxWidth="780"
            Padding="32,20,32,40"
            HorizontalAlignment="Left"
            Spacing="8">
            <TextBlock x:Name="TituloPagina" Style="{StaticResource TituloPaginaStyle}" Text="Acerca de" />
            <TextBlock
                Margin="0,0,0,12"
                Style="{StaticResource SubtituloPaginaStyle}"
                Text="Información del programa y de este equipo." />

            <Border
                Padding="20"
                CornerRadius="8"
                BorderThickness="1"
                DoubleTapped="TarjetaMarca_DoubleTapped">
                <Border.Background>
                    <SolidColorBrush Color="{ThemeResource CardBackgroundFillColorDefault}" />
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="{ThemeResource CardStrokeColorDefault}" />
                </Border.BorderBrush>
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="96"
                        Height="96"
                        VerticalAlignment="Top"
                        Source="ms-appx:///img/logo.ico"
                        Stretch="Uniform" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Iderma Capilar" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Sistema de fichas técnicas de materiales" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE77B;" />
                            <StackPanel>
                                <TextBlock Text="Elaborado por Piero Zavala Ayala" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Área de procesos · Iderma Capilar" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Este equipo" />

            <Border
                CornerRadius="8"
                BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="{ThemeResource CardBackgroundFillColorDefault}" />
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="{ThemeResource CardStrokeColorDefault}" />
                </Border.BorderBrush>
                <StackPanel>
                    <Grid Padding="16,14" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Equipo" />
                        <TextBlock x:Name="TextoEquipo" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="16,14" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Usuario" />
                        <TextBlock x:Name="TextoUsuario" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="16,14" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Sistema" />
                        <TextBlock x:Name="TextoSistema" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="16,14" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Memoria RAM" />
                        <TextBlock x:Name="TextoRam" Grid.Column="1" TextWrapping="Wrap" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="16,14" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Procesadores" />
                        <TextBlock x:Name="TextoProcesadores" Grid.Column="1" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="16,14" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Versión" />
                        <TextBlock x:Name="TextoVersion" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

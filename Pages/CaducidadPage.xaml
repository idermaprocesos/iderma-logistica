<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaFichas.Pages.CaducidadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:IdermaFichas.Models"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="TituloPagina" Style="{StaticResource TituloPaginaStyle}" Text="Vencimientos" />
                <TextBlock
                    Style="{StaticResource SubtituloPaginaStyle}"
                        Text="Materiales vencidos y próximos a caducar, por lote, para retiro o reposición." />
            </StackPanel>
            <ComboBox
                x:Name="ComboHorizonte"
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                SelectionChanged="ComboHorizonte_SelectionChanged" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="16" CornerRadius="12">
                <Border.Background>
                    <SolidColorBrush Color="{ThemeResource CardBackgroundFillColorDefault}" />
                </Border.Background>
                <StackPanel Spacing="4">
                    <TextBlock Foreground="{StaticResource VencidoBrush}" FontWeight="SemiBold" Text="Vencidos" />
                    <TextBlock x:Name="ConteoVencidos" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Opacity="0.7" Text="Ya no deben usarse en procedimiento." />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="16" CornerRadius="12">
                <Border.Background>
                    <SolidColorBrush Color="{ThemeResource CardBackgroundFillColorDefault}" />
                </Border.Background>
                <StackPanel Spacing="4">
                    <TextBlock Foreground="{StaticResource ProximoVencerBrush}" FontWeight="SemiBold" Text="Próximos a vencer" />
                    <TextBlock x:Name="ConteoProximos" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetalleHorizonte" Opacity="0.7" Text="Dentro de los próximos 30 días." />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Productos vencidos" />
                <ListView
                    x:Name="ListaVencidos"
                    Grid.Row="1"
                    IsItemClickEnabled="True"
                    ItemClick="Lista_ItemClick"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AlertaCaducidad">
                            <StackPanel Padding="0,8" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Nombre}" />
                                <TextBlock Opacity="0.7" Text="{x:Bind Resumen}" />
                                <TextBlock Opacity="0.7" Text="{x:Bind LoteTexto}" />
                                <TextBlock Foreground="{StaticResource VencidoBrush}" Text="{x:Bind EstadoCaducidadTexto}" />
                                <TextBlock Opacity="0.6" Text="{x:Bind FechaCaducidadTexto}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Próximos a vencer" />
                <ListView
                    x:Name="ListaProximos"
                    Grid.Row="1"
                    IsItemClickEnabled="True"
                    ItemClick="Lista_ItemClick"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AlertaCaducidad">
                            <StackPanel Padding="0,8" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Nombre}" />
                                <TextBlock Opacity="0.7" Text="{x:Bind Resumen}" />
                                <TextBlock Opacity="0.7" Text="{x:Bind LoteTexto}" />
                                <TextBlock Foreground="{StaticResource ProximoVencerBrush}" Text="{x:Bind EstadoCaducidadTexto}" />
                                <TextBlock Opacity="0.6" Text="{x:Bind FechaCaducidadTexto}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>

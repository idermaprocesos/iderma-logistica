<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaFichas.Pages.BorradoresServicioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IdermaFichas.Pages">

    <Grid Padding="20,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <Button HorizontalAlignment="Left" Click="Volver_Click" Content="Volver" />
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Borradores de orden de servicio" />
        </StackPanel>
        <Grid Grid.Row="1">
            <TextBlock x:Name="Vacio" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.72" Text="No hay órdenes de servicio en borrador." />
            <ListView x:Name="Lista" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:OrdenServicioItem">
                        <Grid Padding="4,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Titulo}" />
                                <TextBlock Opacity="0.75" Text="{x:Bind Resumen}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="Editar_Click" Content="Editar" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind IdTexto}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

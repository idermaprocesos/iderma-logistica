<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaFichas.Pages.OrdenServicioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IdermaFichas.Pages">

    <Grid Padding="24,8,24,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TituloPaginaStyle}" Text="Orden de servicio" />
            <TextBlock
                Style="{StaticResource SubtituloPaginaStyle}"
                Text="Sección distinta de la orden de compra. Marque proveedores y amplíe el contrato por meses." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="CajaBusqueda"
                PlaceholderText="Buscar proveedor, RUC o razón social"
                TextChanged="CajaBusqueda_TextChanged" />
            <ComboBox
                x:Name="FiltroContrato"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                SelectedIndex="0"
                SelectionChanged="Filtro_Changed">
                <ComboBoxItem Content="Todos" />
                <ComboBoxItem Content="Con contrato" />
                <ComboBoxItem Content="Sin contrato" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Resumen" VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" />
            <Button Grid.Column="1" Click="Generar_Click" Content="Generar orden de servicio" Style="{StaticResource AccentButtonStyle}" />
            <Button Grid.Column="2" Click="Borradores_Click" Content="Editar borradores" />
            <Button Grid.Column="3" Click="Anteriores_Click" Content="Órdenes anteriores" />
        </Grid>

        <ListView x:Name="Lista" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ProveedorServicioItem">
                    <Grid Padding="4,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <CheckBox VerticalAlignment="Center" Click="Marca_Click" IsChecked="{x:Bind Marcado, Mode=TwoWay}" Tag="{x:Bind Id}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Nombre}" />
                            <TextBlock Opacity="0.7" Text="{x:Bind Empresa}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Ruc}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Contrato}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar x:Name="Aviso" Grid.Row="4" IsClosable="True" IsOpen="False" />
    </Grid>
</Page>

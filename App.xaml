<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="IdermaFichas.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:IdermaFichas.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="ClinicaColor">#0B6E6B</Color>
            <Color x:Key="OficinaColor">#1B4F72</Color>
            <Color x:Key="LimpiezaColor">#2E7D4F</Color>
            <Color x:Key="MarcaColor">#0B6E6B</Color>
            <Color x:Key="VencidoColor">#C42B1C</Color>
            <Color x:Key="ProximoVencerColor">#C05600</Color>

            <SolidColorBrush x:Key="ClinicaBrush" Color="{StaticResource ClinicaColor}" />
            <SolidColorBrush x:Key="OficinaBrush" Color="{StaticResource OficinaColor}" />
            <SolidColorBrush x:Key="LimpiezaBrush" Color="{StaticResource LimpiezaColor}" />
            <SolidColorBrush x:Key="MarcaBrush" Color="{StaticResource MarcaColor}" />
            <SolidColorBrush x:Key="VencidoBrush" Color="{StaticResource VencidoColor}" />
            <SolidColorBrush x:Key="ProximoVencerBrush" Color="{StaticResource ProximoVencerColor}" />

            <helpers:FechaCalendarioConverter x:Key="FechaCalendarioConverter" />

            <Style x:Key="TituloPaginaStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SubtituloPaginaStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Opacity" Value="0.72" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="EtiquetaCampoStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.72" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="TarjetaAreaStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="TarjetaKpiStyle" TargetType="Border">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="TarjetaKpiBotonStyle" TargetType="Button" BasedOn="{StaticResource TarjetaAreaStyle}">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
